# minecomp-ai — minicomp-ai-agent config

# --- Required ---
# Your OpenAI-compatible API key (OpenRouter, NVIDIA, or any compatible host)
# Alternatively set the MINECOMP_API_KEY environment variable.
api_key: "sk-your-api-key-here"

# --- Model ---
# Any model served over an OpenAI-compatible API .
model: "google/gemini-2.0-flash"
# model: "nvidia/gemini-2.0-flash-xl"
# model: "openai/gpt-4o-mini"

# --- Base URL ---
# OpenRouter (default), or your own compatible endpoint.
base_url: "https://openrouter.ai/api/v1"
# For NVIDIA: "https://integrate.api.nvidia.com/v1"
# For a local model: "http://localhost:1234/v1"

# --- Gateway (server-side WebSocket gateway) ---
# The agent connects to this when you run /wsserver <host>:<port>
# in the Minecraft world.
gateway_host: "127.0.0.1"
gateway_port: 8080
