# minecomp-ai — AI Minecraft Bedrock agent config

# --- Required ---
# Your OpenAI-compatible API key. Set both the API key AND base URL below.
api_key: "your-api-key-here"

# --- Provider Settings ---
# For OpenRouter, OpenAI, NVIDIA, Together AI, Groq, DeepSeek, Mistral,
# Ollama, or any OpenAI-compatible endpoint.
#
# base_url examples:
#   OpenRouter:  https://openrouter.ai/api/v1
#   OpenAI:      https://api.openai.com/v1
#   NVIDIA:      https://integrate.api.nvidia.com/v1
#   Together AI: https://api.together.xyz/v1
#   Groq:        https://api.groq.com/openai/v1
#   DeepSeek:    https://api.deepseek.com/v1
#   Mistral:     https://api.mistral.ai/v1
#   Ollama:      http://localhost:11434/v1
base_url: "https://openrouter.ai/api/v1"

# --- Model Selection ---
# Any model ID from your provider. Run `python -m minecomp --list-models`
# to fetch the available models from your provider.
model: "google/gemini-2.0-flash"

# --- Gateway (server-side WebSocket gateway) ---
# The agent connects to this when you run /wsserver <host>:<port>
# in the Minecraft world.
gateway_host: "127.0.0.1"
gateway_port: 8080
